# Copy to .env (gitignored) or store in Infisical (see docs/secrets.md).
# Never commit real values.

BS_ACCOUNT=
BS_PASSWORD=
BS_ACCOUNT_CODE=default

BS_MODEL_PATH=models/common_old.onnx
BS_CHARSET_PATH=models/charset.json
BS_SESSION_PATH=.session.json
BS_BASE_URL=https://www.bigseller.com
BS_OCR_THREADS=4
BS_LOGIN_ATTEMPTS=8

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

API_BIND=0.0.0.0:8080
API_TOKEN=change-me

SYNC_NEW_INTERVAL_SECS=60
CANCEL_HOUR_LOCAL=17
CANCEL_MINUTE_LOCAL=0
AUTO_RELOGIN=true
# Scheduled batch printer email + automatic BigSeller printed mark.
# Keep false to require manual printing; group notifications remain active.
AUTO_PRINT=false

# Working-hours window (WIB). Outside this window the worker sleeps for
# BigSeller (no new-order/reconcile/bucket/outbox sync); daily scheduled jobs
# and the evening cancel sync still run on their own clocks.
# Urgent/instant order notifications that arrive outside the window are
# deferred to the next work start (sent automatically when the window opens).
WORK_HOUR_START=07:50
WORK_HOUR_END=17:00

# Scheduled ops jobs (worker, WIB clock, once per day)
# Batch pagi: claim backlog -> 2-up Summary List PDF -> email to RESEND_TO
# (e.g. printer@print.epsonconnect.com). Requires RESEND_API_KEY + RESEND_TO.
BATCH_PAGI_HOUR=08:00
# Batch siang: same flow for the afternoon session (backlog sejak pagi).
BATCH_SIANG_HOUR=13:05
# Rekap sore: daily infographic PNG -> WhatsApp group (requires WAZAPIN).
REKAP_HOUR=17:00
# Cancel printed: hari-ini cancel yang summary list sudah di-print -> WA group.
# Runs at CANCEL_HOUR_LOCAL:CANCEL_MINUTE_LOCAL (default 17:00).
# Instant batch: gabungkan notif pesanan instant jadi 1 kartu WA per interval
# menit, hanya selama jam kerja (default 5 menit).
INSTANT_BATCH_INTERVAL_MIN=5

# WA_WEBHOOK_URL=
# WA_WEBHOOK_TOKEN=

# Wazapin — instant order PNG → WhatsApp group (worker outbox)
# WAZAPIN_API_KEY=wzp_...
# WAZAPIN_CHANNEL_ID=wzp_...
# WAZAPIN_GROUP_JID=120363...@g.us
# WAZAPIN_BASE_URL=https://api.wazapin.com
# WAZAPIN_NOTIFY_INSTANT=true   # notif pesanan instant (digabung 5 menit)
# WAZAPIN_NOTIFY_CANCEL=true    # notif cancel yang summary sudah di-print
# WAZAPIN_NOTIFY_BATCH=true     # PDF summary batch pagi/siang → grup (selain email)
# WAZAPIN_MENTION_ALL=true     # @all di kartu pesanan instant (hanya channel unofficial)
# WAZAPIN_ORG_SLUG=

# Email — Resend HTTP API (sender domain must be verified in Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM="Order.rs <noreply@obayito.com>"
# RESEND_TO=printer@print.epsonconnect.com

